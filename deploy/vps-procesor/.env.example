# Created by the AGI PROCESOR project in 2026.
# Copy to .env on the VPS, set mode 0600, and replace every CHANGE_ME value.
# Never commit the resulting .env file.

# Required: generate with `openssl rand -hex 32`.
OPENJARVIS_API_KEY=CHANGE_ME_64_HEX_CHARACTERS

# Only nginx on the same VPS should reach this loopback port.
AGI_PROCESOR_HOST_PORT=8088

# Public referral URL; this is not a credential.
AGI_PROCESOR_FOMO_REFERRAL_URL=https://fomo.family/r/AGIPROCESOR

# The alert scheduler must remain disabled until a reviewed, authorised source
# supplies current snapshots. Uptime alone is not current market data.
AGI_PROCESOR_ALERTS_SCHEDULER_ENABLED=false

# Fail closed on old/future market observations and make concurrent delivery
# retry behaviour explicit. Keep these conservative until the feed is tested.
AGI_PROCESOR_ALERTS_MAX_SNAPSHOT_AGE_SECONDS=900
AGI_PROCESOR_ALERTS_MAX_FUTURE_SKEW_SECONDS=60
AGI_PROCESOR_ALERTS_DELIVERY_LEASE_SECONDS=120
AGI_PROCESOR_ALERTS_MAX_ATTEMPTS_PER_CHANNEL=3
AGI_PROCESOR_ALERTS_RETRY_BACKOFF_SECONDS=60

# SMTP email (optional). For Hostinger use the exact SMTP host/port shown in
# its mailbox panel. Use a dedicated app/mailbox password, not the VPS login.
AGI_PROCESOR_ALERTS_SMTP_HOST=
AGI_PROCESOR_ALERTS_SMTP_PORT=587
AGI_PROCESOR_ALERTS_SMTP_USERNAME=
AGI_PROCESOR_ALERTS_SMTP_PASSWORD=
AGI_PROCESOR_ALERTS_SMTP_FROM=
AGI_PROCESOR_ALERTS_SMTP_USE_SSL=false
AGI_PROCESOR_ALERTS_SMTP_STARTTLS=true
AGI_PROCESOR_ALERTS_EMAIL_TO=

# Telegram (optional, free transport; bot creation and chat opt-in required).
AGI_PROCESOR_ALERTS_TELEGRAM_BOT_TOKEN=
AGI_PROCESOR_ALERTS_TELEGRAM_CHAT_ID=

# ntfy push (optional). URL must be a complete HTTPS topic endpoint. Use a
# private/self-hosted topic for sensitive alerts.
AGI_PROCESOR_ALERTS_NTFY_URL=
AGI_PROCESOR_ALERTS_NTFY_TOKEN=

# Optional SMS. Blank mode means disabled. `email_gateway` uses the provider's
# email-to-SMS address. `http` requires HTTPS and an explicit host allowlist.
# Production SMS normally incurs carrier/provider charges.
AGI_PROCESOR_ALERTS_SMS_MODE=
AGI_PROCESOR_ALERTS_SMS_EMAIL_TO=
AGI_PROCESOR_ALERTS_SMS_HTTP_URL=
AGI_PROCESOR_ALERTS_SMS_HTTP_TOKEN=
AGI_PROCESOR_ALERTS_SMS_TO=
AGI_PROCESOR_ALERTS_SMS_ALLOWED_HOSTS=
AGI_PROCESOR_ALERTS_SMS_MAX_CHARS=300
AGI_PROCESOR_ALERTS_SMS_ALLOW_MULTIPART=false
